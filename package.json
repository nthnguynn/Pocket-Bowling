{
  "name": "pocket-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n SIGNAL,ARCADE,BOWLING,MARBLE,SUMO,ROLL -c magenta,cyan,yellow,blue,green,red \"npm:signal\" \"npm run dev -w @pocket/arcade\" \"npm run dev -w @pocket/bowling\" \"npm run dev -w @pocket/marble\" \"npm run dev -w @pocket/sumo\" \"npm run dev -w @pocket/roll\"",
    "dev:arcade": "concurrently -k -n SIGNAL,ARCADE -c magenta,cyan \"npm:signal\" \"npm run dev -w @pocket/arcade\"",
    "dev:bowling": "concurrently -k -n SIGNAL,BOWLING -c magenta,cyan \"npm:signal\" \"npm run dev -w @pocket/bowling\"",
    "dev:marble": "concurrently -k -n SIGNAL,MARBLE -c magenta,cyan \"npm:signal\" \"npm run dev -w @pocket/marble\"",
    "dev:sumo": "concurrently -k -n SIGNAL,SUMO -c magenta,cyan \"npm:signal\" \"npm run dev -w @pocket/sumo\"",
    "dev:roll": "concurrently -k -n SIGNAL,ROLL -c magenta,cyan \"npm:signal\" \"npm run dev -w @pocket/roll\"",
    "signal": "tsx watch --env-file-if-exists=.env packages/party-kit/server/signaling.ts",
    "serve": "tsx --env-file-if-exists=.env packages/party-kit/server/serve.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  }
}
