# Web (dùng chung cho mọi site; mỗi site chạy ở cổng riêng cố định trong vite.config.ts của nó)
# HTTPS is required for phone motion sensors. Create a trusted LAN certificate with mkcert.
# HTTPS_CERT=C:/certs/pocket-bowling.pem
# HTTPS_KEY=C:/certs/pocket-bowling-key.pem

# Signaling server
SIGNAL_HOST=0.0.0.0
SIGNAL_PORT=8787
ROOM_TTL_MS=3600000
# Số điện thoại tối đa mỗi phòng (game đông nhất 8 người chơi + chỗ cho máy xem/kết nối lại).
MAX_CONTROLLERS=10
# Must be wss:// when the page is served over HTTPS.
# VITE_SIGNALING_URL=wss://192.168.1.20:8787

# TLS for WSS. The same mkcert pair can be used.
# SIGNAL_TLS_CERT=C:/certs/pocket-bowling.pem
# SIGNAL_TLS_KEY=C:/certs/pocket-bowling-key.pem

# ICE. Public STUN is only for discovery; TURN credentials are minted by signaling.
STUN_URLS=stun:stun.cloudflare.com:3478
# TURN_URLS=turn:192.168.1.20:3478?transport=udp,turn:192.168.1.20:3478?transport=tcp,turns:example.com:5349?transport=tcp
# TURN_SECRET=replace-with-the-same-long-random-secret-as-coturn
# TURN_REALM=pocket-bowling.local

# Deploy: mỗi site một địa chỉ riêng. Bỏ trống khi dev (tự dùng cùng máy, cổng dev của từng site).
# VITE_ARCADE_URL=https://arcade.example.com/
# VITE_SITE_BOWLING_URL=https://bowling.example.com/
# VITE_SITE_MARBLE_URL=https://marble.example.com/
# VITE_SITE_SUMO_URL=https://sumo.example.com/
# VITE_SITE_ROLL_URL=https://roll.example.com/
