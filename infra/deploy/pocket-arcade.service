# Giữ Pocket Arcade chạy nền trên Linux (web + signaling, cổng 3003).
# 1. Sửa User, WorkingDirectory và đường dẫn npm (`which npm`) cho đúng server.
# 2. sudo cp infra/deploy/pocket-arcade.service /etc/systemd/system/
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now pocket-arcade
# 4. Xem log: journalctl -u pocket-arcade -f
[Unit]
Description=Pocket Arcade (web + signaling, cổng 3003)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/Pocket-Bowling
Environment=PORT=3003
ExecStart=/usr/bin/npm run serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
