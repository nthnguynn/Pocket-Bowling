# Mẫu nginx trỏ tên miền (có HTTPS) vào server một cổng localhost:3003.
# Điểm bắt buộc: chuyển tiếp WebSocket (Upgrade/Connection) để signaling ở /ws hoạt động.
# HTTPS: chạy `sudo certbot --nginx -d game.example.com` sau khi có file này.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name game.example.com;

    location / {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Server ping WebSocket mỗi 30 giây; để rộng cho chắc.
        proxy_read_timeout 1h;
    }
}
